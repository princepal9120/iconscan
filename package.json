{
  "name": "iconscan",
  "version": "0.1.0",
  "description": "Deterministic icon audit for React / Next.js / TypeScript projects. Score, find dead icons, recommend alternatives.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "keywords": [
    "icon",
    "audit",
    "lint",
    "react",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "iconscan": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "tsup src/cli.ts --format esm --target node18 --minify",
    "start": "node dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.0.0",
    "lucide-react": "^0.544.0",
    "react-icons": "^5.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^10.0.0"
  }
}
